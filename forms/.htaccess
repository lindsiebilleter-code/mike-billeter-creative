# Only the two public endpoints are reachable; data/ and _lib.php are not.
<FilesMatch "^(_lib\.php|.*\.tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data(/|$) - [F,L]
</IfModule>
